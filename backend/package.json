{
  "name": "lupohub-backend",
  "version": "1.0.0",
  "description": "API Backend para LupoHub",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "cross-env PORT=3010 nodemon src/index.ts",
    "build": "tsc",
    "init-db": "ts-node src/database/init.ts",
    "merge-trifil": "ts-node scripts/merge-trifil-products.ts",
    "merge-trifil:prod": "cross-env NODE_ENV=production ts-node scripts/merge-trifil-products.ts",
    "parse-tango": "node scripts/parse-tango-articulos.js",
    "create-cert-prod": "ts-node scripts/create-cert-prod.ts",
    "auth-web-service-prod": "ts-node scripts/auth-web-service-prod.ts",
    "delete-billing-by-cae": "ts-node scripts/delete-billing-by-cae.ts",
    "delete-billing-by-cae:prod": "cross-env NODE_ENV=production ts-node scripts/delete-billing-by-cae.ts",
    "import-multimedia-saldos": "ts-node scripts/import-multimedia-composicion-saldos.ts",
    "import-seller-commissions": "ts-node scripts/import-seller-commissions.ts",
    "import-pending-payments": "ts-node scripts/import-pending-payments.ts"
  },
  "dependencies": {
    "@afipsdk/afip.js": "^1.2.3",
    "@types/jsonwebtoken": "^9.0.10",
    "axios": "^1.13.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.12.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.9.2",
    "pdf-parse": "^2.4.5",
    "uuid": "^9.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.13",
    "@types/node": "^20.11.24",
    "@types/uuid": "^9.0.8",
    "cross-env": "^7.0.3",
    "nodemon": "^3.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
