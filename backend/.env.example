# Copiá a .env y completá. Para producción usá Railway → Variables.

# ============== IA — Preguntas Mercado Libre (Gemini) ==============
# 1) Creá la clave en https://aistudio.google.com/apikey
# 2) Pegala acá (local) o en Railway (producción)
GEMINI_API_KEY=
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash
# Búsqueda en Google cuando falta info en la ficha (solo Gemini). true por defecto.
ML_QUESTIONS_AI_WEB_SEARCH=true

# ============== Servidor local ==============
# PORT=3010
