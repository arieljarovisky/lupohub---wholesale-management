# ============== PLANTILLA PARA RAILWAY ==============
# Copiá estas variables en Railway → tu proyecto backend → Variables.
# No subas este archivo con valores reales; usalo solo como referencia.

# ============== BASE DE DATOS ==============
# Railway suele inyectar MYSQL_URL o variables sueltas al agregar el plugin MySQL.
# Si usás variables sueltas, descomentá y completá:
# DB_HOST=containers-us-west-xxx.railway.app
# DB_USER=root
# DB_PASSWORD=xxx
# DB_NAME=railway
# DB_PORT=3306
# O una sola URL:
# MYSQL_URL=mysql://user:password@host:port/railway

# ============== SERVIDOR ==============
# PORT lo asigna Railway; no hace falta definirlo.

# ============== AUTH ==============
# JWT_SECRET=genera-un-secreto-largo-y-aleatorio-para-produccion
# ADMIN_EMAIL=admin@tudominio.com
# ADMIN_PASSWORD=tu-contraseña-segura

# ============== AFIP SDK – FACTURACIÓN ==============
# Obligatorio: tu CUIT de 11 dígitos (solo números).
AFIP_CUIT=20123456789

# Opción recomendada en Railway: token de app.afipsdk.com (no hace falta subir .crt/.key).
# Entrá a https://app.afipsdk.com, iniciá sesión y copiá el access token.
AFIP_ACCESS_TOKEN=VxdOv3XicxI1TMIcZjhicn3at9WYsaTWVeq0rSHAU4EMX1QnILIRZSZFbhCAGhWZ

# Punto de venta (número). Por defecto 1 si no lo definís.
AFIP_PTO_VTA=1

# true = facturas reales (producción AFIP). Sin esto = homologación.
AFIP_PRODUCTION=true

# --- Si en vez de token usás certificado y clave (Opción B): ---
# Pegá el contenido completo del .crt en AFIP_CERT_PATH y del .key en AFIP_KEY_PATH.
# Si Railway no acepta varias líneas, usá una sola línea con \n donde van los saltos, ej.:
# AFIP_CERT_PATH=-----BEGIN CERTIFICATE-----\nMIIE...\n-----END CERTIFICATE-----
# AFIP_KEY_PATH=-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----
# En ese caso NO definas AFIP_ACCESS_TOKEN.

# ============== OPCIONAL: INTEGRACIONES ==============
# MERCADO_LIBRE_APP_ID=...
# MERCADO_LIBRE_CLIENT_SECRET=...
# MERCADO_LIBRE_REDIRECT_URI=https://tu-backend.railway.app/api/integrations/mercadolibre/callback
# TIENDA_NUBE_APP_ID=...
# TIENDA_NUBE_CLIENT_SECRET=...
# TIENDA_NUBE_REDIRECT_URI=https://tu-backend.railway.app/api/integrations/tiendanube/callback
# FRONTEND_URL=https://tu-app.vercel.app
#
# ============== META ADS (marketing) ==============
# Token de larga duración con permiso ads_read desde Meta Business / Graph API Explorer
# META_ADS_ACCESS_TOKEN=EAA...
# ID de cuenta publicitaria (con o sin prefijo act_)
# META_ADS_ACCOUNT_ID=1234567890
#
# ============== GOOGLE ADS (marketing) ==============
# OAuth desde Google Cloud Console (credenciales de aplicación web)
# GOOGLE_ADS_CLIENT_ID=....apps.googleusercontent.com
# GOOGLE_ADS_CLIENT_SECRET=...
# Developer token desde Google Ads API Center
# GOOGLE_ADS_DEVELOPER_TOKEN=...
# Refresh token OAuth (scope https://www.googleapis.com/auth/adwords)
# GOOGLE_ADS_REFRESH_TOKEN=1//...
# Customer ID de la cuenta publicitaria (10 dígitos, sin guiones)
# GOOGLE_ADS_CUSTOMER_ID=1234567890
# Opcional: ID de cuenta manager si accedés vía MCC
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=9876543210
#
# ============== MERCADO PAGO (resultados empresa) ==============
# Access token de producción desde https://www.mercadopago.com.ar/developers/panel/app
# MERCADOPAGO_ACCESS_TOKEN=APP_USR-...
#
# ============== WEBHOOK STOCK A TIENDA PROPIA (Lupo Shop) ==============
# HUB_STOCK_WEBHOOK_ENABLED=1
# HUB_STOCK_WEBHOOK_URL=https://tu-tienda.com/api/hub/webhook/stock
# HUB_API_KEY=tu_api_key_privada
# HUB_WEBHOOK_SECRET=tu_secreto_hmac
# HUB_STOCK_WEBHOOK_TIMEOUT_MS=10000
# HUB_STOCK_WEBHOOK_MAX_RETRIES=4
# HUB_STOCK_WEBHOOK_BACKOFF_BASE_MS=1000
